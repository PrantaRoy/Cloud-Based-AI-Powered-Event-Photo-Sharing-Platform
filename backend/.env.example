APP_NAME=EventPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No relational database — the domain model lives entirely in DynamoDB.
# These framework subsystems use non-DB drivers:
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@eventpro.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS -------------------------------------------------------------------
# Local dev: point DynamoDB at amazon/dynamodb-local and use dummy creds.
# Production (EC2): leave DYNAMODB_ENDPOINT and the keys blank so the SDK
# uses the instance role.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=ap-southeast-2
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3 bucket for event media / banners / thumbnails (Storage `s3` disk).
AWS_BUCKET=
AWS_URL=

# DynamoDB single-table
DYNAMODB_TABLE=EventPhotoPlatform-local
DYNAMODB_REGION=ap-southeast-2
DYNAMODB_ENDPOINT=http://localhost:8001

# Stateless JWT auth secret (replaces Sanctum). Falls back to APP_KEY if blank.
JWT_SECRET=
JWT_TTL_DAYS=7

VITE_APP_NAME="${APP_NAME}"
