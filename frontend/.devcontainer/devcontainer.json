{
  "name": "EventPro",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5173, 8000, 3001],
  "portsAttributes": {
    "5173": { "label": "Vite (React)", "onAutoForward": "openBrowser" },
    "8000": { "label": "Laravel API" },
    "3001": { "label": "Mock API (json-server)" }
  },
  "postCreateCommand": "npm install && npm install -g json-server",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
