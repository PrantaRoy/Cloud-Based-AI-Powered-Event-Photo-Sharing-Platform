{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndDeleteSelfie",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::eventpro-media-ACCOUNT_ID/tmp/*"
    },
    {
      "Sid": "ReadFaceRowsOnly",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:ap-southeast-2:ACCOUNT_ID:table/EventPhotoPlatform-prod"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:ACCOUNT_ID:log-group:/aws/lambda/framefind-search:*"
    }
  ]
}
