# Production .env for the EventPro API on EC2.
# Copy to  infra/.env  on the host (ec2-user-data.sh does this for you,
# pulling APP_KEY and JWT_SECRET from AWS Secrets Manager).

APP_NAME=EventPro
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # base64:...  from Secrets Manager (eventpro/app-key)

# --- Auth: Amazon Cognito ------------------------------------------------
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=   # from Secrets Manager (eventpro/cognito-client-secret)
# JWT_SECRET is unused in Cognito mode; keep a value so the config never errors.
JWT_SECRET=unused-in-cognito-mode

# Public URL of the API (the CloudFront domain, or the ALB DNS name for the
# all-HTTP setup). Used to build absolute media / QR URLs.
APP_URL=https://d1234567890.cloudfront.net
# Public URL of the SPA. Used for QR-code links and password-reset links.
FRONTEND_URL=https://d1234567890.cloudfront.net

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# No relational DB. Framework subsystems use non-DB drivers.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- AWS: reached via the EC2 instance role, so NO keys here ---------------
AWS_DEFAULT_REGION=ap-southeast-2
AWS_USE_PATH_STYLE_ENDPOINT=false

# DynamoDB single-table (real AWS — leave DYNAMODB_ENDPOINT unset)
DYNAMODB_TABLE=EventPhotoPlatform-prod
DYNAMODB_REGION=ap-southeast-2

# S3 media bucket. AWS_URL makes Storage::url() return CloudFront URLs
# (Path B). Leave AWS_URL blank for a public-read bucket (Path A).
FILESYSTEM_DISK=s3
AWS_BUCKET=eventpro-media-<ACCOUNT_ID>
AWS_URL=https://d1234567890.cloudfront.net/media
